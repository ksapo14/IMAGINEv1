# Website canonical origin (optional for local development).
NEXT_PUBLIC_SITE_URL=
FRONTEND_PORT=3000

# Set these in the Windows launch environment for the desktop application.
# Optional absolute or repository-relative path to its local Python interpreter.
IMAGINE_PYTHON=
# The key is read only by Tauri's Rust process and is never bundled into React.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_EOT_THRESHOLD=0.7
DEEPGRAM_EOT_TIMEOUT_MS=1500
DEEPGRAM_LANGUAGE_HINT=

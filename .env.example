# Structured Live Assistant output.
GEMINI_TEXT_MODEL=gemini-3.7-flash
# Optional monochrome outline and stick-figure images.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

CORS_ALLOW_ORIGIN_REGEX=

NEXT_PUBLIC_API_BASE_URL=
# Optional public deployment policy and canonical site origin.
NEXT_PUBLIC_FRONTEND_ONLY=
NEXT_PUBLIC_VERCEL_ENV=
NEXT_PUBLIC_SITE_URL=
FRONTEND_PORT=3000
BACKEND_PORT=8010

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_EOT_THRESHOLD=0.7
DEEPGRAM_EOT_TIMEOUT_MS=1500
DEEPGRAM_LANGUAGE_HINT=

# Choose auto (local when FUNCTION_GEMMA_LOCAL_PYTHON is set), local, or http.
FUNCTION_GEMMA_RUNTIME=auto
# Local mode starts a private offline subprocess; it needs an existing Python
# environment with cached FunctionGemma, torch, and transformers.
FUNCTION_GEMMA_LOCAL_PYTHON=
FUNCTION_GEMMA_LOCAL_STARTUP_TIMEOUT_SECONDS=90
FUNCTION_GEMMA_LOCAL_INFERENCE_TIMEOUT_SECONDS=12
# HTTP mode uses a separately managed OpenAI-compatible server at this endpoint.
# Leave blank for the native backend default; Docker Compose supplies its default.
FUNCTION_GEMMA_BASE_URL=
FUNCTION_GEMMA_MODEL=google/functiongemma-270m-it
# Optional static bearer token for a server that accepts Authorization: Bearer.
FUNCTION_GEMMA_API_KEY=

CORS_ALLOW_ORIGIN_REGEX=

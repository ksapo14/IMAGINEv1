NEXT_PUBLIC_FRONTEND_ONLY=
NEXT_PUBLIC_VERCEL_ENV=
NEXT_PUBLIC_SITE_URL=
FRONTEND_PORT=3000
BACKEND_PORT=8010

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en

NEXT_PUBLIC_API_BASE_URL=
# Optional public deployment policy and canonical site origin.
NEXT_PUBLIC_FRONTEND_ONLY=
NEXT_PUBLIC_VERCEL_ENV=
NEXT_PUBLIC_SITE_URL=
FRONTEND_PORT=3000
BACKEND_PORT=8010

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_EOT_THRESHOLD=0.7
DEEPGRAM_EOT_TIMEOUT_MS=1500
DEEPGRAM_LANGUAGE_HINT=

PROD_GEMINI_API_KEY=
# Structured Live Assistant output.
GEMINI_TEXT_MODEL=gemini-3.7-flash
# Remove this variable to use gemini-3.6-flash; leave it blank to disable fallback.
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.6-flash
# Generated visual and diagram images.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Remove this variable to use gemini-2.5-flash-image; leave it blank to disable fallback.
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

CORS_ALLOW_ORIGIN_REGEX=
